@{
    ViewData["Title"] = "About Us";
}
<h1>@ViewData["Title"]</h1>
<p>Learn more about our group!</p>

<div class="card-body">
    <h2 class="h4 card-title">Person</h2><br />
    <p class="card-text">
        put a short bio about who you are and what movies mean to you.
    </p>

    <p><strong>Favorite Movie:</strong> [Movie title]</p>
    <p><strong>Favorite Genre:</strong> [Genre]</p>
    <p><strong>Movie Snack:</strong> [Snack]</p>

    <hr>
</div>
